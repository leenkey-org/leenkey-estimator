{
  "name": "leenkey-estimator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "a11y": "playwright test --grep @a11y",
    "format": "prettier --write .",
    "db:migrate:local": "scripts/db-migrate.sh local",
    "db:migrate:staging": "scripts/db-migrate.sh staging",
    "db:migrate:prod": "scripts/db-migrate.sh prod",
    "db:rls-test": "scripts/db-rls-test.sh",
    "db:seed": "scripts/db-seed.sh local",
    "db:seed:staging": "scripts/db-seed.sh staging",
    "kb:import": "scripts/kb-import.sh local",
    "kb:import:staging": "scripts/kb-import.sh staging",
    "kb:eval": "node scripts/kb-eval.mjs",
    "ai:eval-search": "vitest run --config vitest.eval.config.ts",
    "db:types": "scripts/db-types.sh",
    "stripe:listen": "stripe listen --events checkout.session.completed,charge.refunded --forward-to localhost:3000/api/webhooks/stripe",
    "backup": "scripts/backup.sh",
    "restore": "scripts/restore.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "next": "^15.5.27",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.32.0",
    "@next/eslint-plugin-next": "^16.4.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.7"
  }
}
