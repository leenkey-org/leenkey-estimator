# Leenkey V2 · variables d'environnement
# Copier en .env.local (jamais commité). Préprod : projet Vercel `leenkey-v2` (onglet Production). Prod : projet `leenkey-estimator-main`.

# Public (exposées au navigateur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENV=local                # local | staging | production

# Serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ACCOMPAGNE=             # 990 € TTC
STRIPE_PRICE_SERENITE=               # 1 500 € TTC
STRIPE_PRICE_UPGRADE=                # Accompagné → Sérénité, 510 € TTC
ADMIN_NOTIFICATION_EMAIL=            # admin@leenkey.fr en prod
EMAIL_TEST_INBOX=                    # destinataire unique des emails hors prod
ANTHROPIC_API_KEY=
RESEND_API_KEY=
CRON_SECRET=
PREPROD_USER=                        # préprod uniquement (middleware), vide en local et en prod
PREPROD_PASSWORD=                    # préprod uniquement
AI_MODEL_FAST=                       # facultatif
AI_MODEL_SMART=                      # facultatif
AI_MOCK=0                            # 1 en E2E
SEED_PASSWORD=                       # local et staging uniquement
