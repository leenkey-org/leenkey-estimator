{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?leenkey\\.com"
        }
      ],
      "destination": "https://leenkey.fr/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www\\.leenkey\\.fr"
        }
      ],
      "destination": "https://leenkey.fr/$1",
      "permanent": true
    }
  ]
}
