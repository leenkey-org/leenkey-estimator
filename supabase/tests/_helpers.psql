-- Shared helpers for RLS tests. Included by each rls_*.sql file, inside its
-- transaction (everything is rolled back at the end of the file).
-- The five accounts of CLAUDE.md section 7 (seller_a, seller_b, buyer_c, buyer_d,
-- admin), as fixtures with their own ids and emails, so the tests also run on a
-- seeded database (supabase/seed/04_accounts.sql). Assertions stay scoped to
-- the fixtures.
create extension if not exists pgtap with schema extensions;
set search_path = public, extensions;

create schema if not exists tests;
grant usage on schema tests to anon, authenticated;

create or replace function tests.uid(p_name text) returns uuid
language sql immutable as $$
  select case p_name
    when 'seller_a' then '00000000-0000-4000-a000-00000000000a'::uuid
    when 'seller_b' then '00000000-0000-4000-a000-00000000000b'::uuid
    when 'buyer_c'  then '00000000-0000-4000-a000-00000000000c'::uuid
    when 'buyer_d'  then '00000000-0000-4000-a000-00000000000d'::uuid
    when 'admin'    then '00000000-0000-4000-a000-0000000000ad'::uuid
  end;
$$;
grant execute on function tests.uid(text) to anon, authenticated;

-- Create the five accounts through auth.users, so the signup trigger runs.
insert into auth.users (id, email, raw_user_meta_data, aud, role)
values
  (tests.uid('seller_a'), 'seller_a@rls.leenkey.test', '{"role":"seller","first_name":"Alice"}', 'authenticated', 'authenticated'),
  (tests.uid('seller_b'), 'seller_b@rls.leenkey.test', '{"role":"seller","first_name":"Bruno"}', 'authenticated', 'authenticated'),
  (tests.uid('buyer_c'),  'buyer_c@rls.leenkey.test',  '{"role":"buyer","first_name":"Chloé"}',  'authenticated', 'authenticated'),
  (tests.uid('buyer_d'),  'buyer_d@rls.leenkey.test',  '{"role":"buyer","first_name":"David"}',  'authenticated', 'authenticated'),
  (tests.uid('admin'),    'admin@rls.leenkey.test',    '{"role":"admin","first_name":"Cédric"}', 'authenticated', 'authenticated');
-- 'admin' in metadata is ignored by the trigger; the role is granted here as superuser.
update public.profiles set roles = '{admin}' where id = tests.uid('admin');

-- pgTAP keeps its state in temp tables created by plan(): call
-- \ir _plan.psql right after select plan(n) so test roles can write them.

-- A valid DPE on the property of a listing (L1-65): what listing_submit asks
-- before a sending, for the tests that are not about the DPE itself
-- (rls_dpe_publication.sql is). Security definer: called under any role.
create or replace function tests.dpe(p_listing uuid) returns void
language sql security definer set search_path = '' as $$
  update public.properties p
     set dpe_class = coalesce(p.dpe_class, 'D'), ges_class = coalesce(p.ges_class, 'D'),
         dpe_date = current_date - 30, energy_cost_min_cents = 120000,
         energy_cost_max_cents = 170000, energy_price_year = 2023,
         dpe_number = coalesce(p.dpe_number, '2491E0000000A'),
         energy_kwh_m2_year = 215, ges_kg_m2_year = 40
    from public.listings l
   where l.id = p_listing and p.id = l.property_id;
$$;
grant usage on schema tests to anon, authenticated;
grant execute on function tests.dpe(uuid) to anon, authenticated;
